{
  "name": "@codexsun/blog",
  "version": "1.0.10",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/apps/blogs/contracts/index.d.ts",
      "import": "./dist/apps/blogs/contracts/index.js"
    },
    "./api": {
      "types": "./dist/apps/blogs/api/index.d.ts",
      "import": "./dist/apps/blogs/api/index.js"
    },
    "./web": "./src/web/src/index.ts",
    "./contracts": {
      "types": "./dist/apps/blogs/contracts/index.d.ts",
      "import": "./dist/apps/blogs/contracts/index.js"
    }
  },
  "workspaces": [
    "src/api",
    "src/web",
    "src/contracts"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run clean && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke:host-contract": "npm run build && node tools/host-contract-smoke.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "version:show": "node tools/version.mjs show",
    "version:bump": "node tools/version-bump.mjs",
    "changelog:append": "node tools/version.mjs append",
    "github:now": "node tools/github-now.mjs",
    "git:release": "node tools/git-release.mjs",
    "clean": "node tools/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2"
  }
}
